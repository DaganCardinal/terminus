{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "terminus",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terminus",
      "migrations_dir": "migrations",
    },
  ],
}
