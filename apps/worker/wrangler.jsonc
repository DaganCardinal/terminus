{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "terminus",
  "preview_urls": false,
  // Preserve the protected workers.dev app URL when adding preview routes.
  "workers_dev": true,
  // Deployment-specific values (account, preview route, origins, Access and
  // account IDs) live in the ignored wrangler.local.jsonc, merged in by
  // scripts/wrangler.mjs. See wrangler.local.example.jsonc.
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "build": { "command": "npm run build --workspace @terminus/web" },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Hostname routing must precede assets on every application preview path.
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terminus",
      "migrations_dir": "migrations",
      // Deploys and remote migrations find the database by name.
    },
  ],
  // npm download caches keyed by lockfile hash, shared by every Sandbox
  // install. Contents are public registry tarballs that npm verifies against
  // the lockfile's integrity hashes; entries are disposable.
  "r2_buckets": [
    {
      "binding": "DEPENDENCY_CACHE",
      "bucket_name": "terminus-dependency-cache",
    },
  ],
  // Browser Run, used only by the deployed transport proof until it passes
  // (docs/browser-run.md). BROWSER_RUN_ENABLED below gates every use.
  "browser": { "binding": "BROWSER" },
  "workflows": [
    {
      "name": "terminus-junction",
      "binding": "JUNCTION_WORKFLOW",
      "class_name": "JunctionWorkflow",
    },
    {
      "name": "terminus-technician",
      "binding": "TECHNICIAN_WORKFLOW",
      "class_name": "TechnicianWorkflow",
    },
    {
      "name": "terminus-dispatch",
      "binding": "DISPATCH_WORKFLOW",
      "class_name": "DispatchWorkflow",
    },
    {
      "name": "terminus-dispatcher-turn",
      "binding": "DISPATCHER_TURN_WORKFLOW",
      "class_name": "DispatcherTurnWorkflow",
    },
    {
      "name": "terminus-train",
      "binding": "TRAIN_WORKFLOW",
      "class_name": "TrainWorkflow",
    },
    {
      "name": "terminus-station",
      "binding": "STATION_WORKFLOW",
      "class_name": "StationWorkflow",
    },
    {
      "name": "terminus-integration",
      "binding": "INTEGRATION_WORKFLOW",
      "class_name": "IntegrationWorkflow",
    },
    {
      "name": "terminus-conflict-watch",
      "binding": "CONFLICT_WATCH_WORKFLOW",
      "class_name": "ConflictWatchWorkflow",
    },
  ],
  // Agent roles run harnesses in ExecutionSandbox. Git, validation and
  // previews run in the agentless WorkspaceSandbox, which has its own image
  // and instance budget, and can never be granted model access. Both are
  // container-less addresses: each routes to a container class of the size
  // chosen in Settings → Sandboxes, one class per size, all built from the
  // kind's image. Keep sizes in step with SANDBOX_SIZES in
  // packages/protocol/src/sandbox.ts.
  // max_instances is only the platform ceiling, and must equal
  // MAX_SANDBOX_INSTANCES in packages/protocol/src/sandbox.ts. Each network's
  // real limit is a setting (Settings → Sandboxes), enforced by Sandbox leases.
  "containers": [
    {
      "class_name": "ExecutionSandboxStandard1",
      "image": "./Dockerfile",
      "max_instances": 100,
      "instance_type": "standard-1",
    },
    {
      "class_name": "ExecutionSandboxStandard2",
      "image": "./Dockerfile",
      "max_instances": 100,
      "instance_type": "standard-2",
    },
    {
      "class_name": "ExecutionSandboxStandard3",
      "image": "./Dockerfile",
      "max_instances": 100,
      "instance_type": "standard-3",
    },
    {
      "class_name": "WorkspaceSandboxStandard1",
      "image": "./Dockerfile.workspace",
      "max_instances": 100,
      "instance_type": "standard-1",
    },
    {
      "class_name": "WorkspaceSandboxStandard2",
      "image": "./Dockerfile.workspace",
      "max_instances": 100,
      "instance_type": "standard-2",
    },
    {
      "class_name": "WorkspaceSandboxStandard3",
      "image": "./Dockerfile.workspace",
      "max_instances": 100,
      "instance_type": "standard-3",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "ExecutionSandbox" },
      { "name": "WORKSPACE_SANDBOX", "class_name": "WorkspaceSandbox" },
      {
        "name": "SANDBOX_STANDARD_1",
        "class_name": "ExecutionSandboxStandard1",
      },
      {
        "name": "SANDBOX_STANDARD_2",
        "class_name": "ExecutionSandboxStandard2",
      },
      {
        "name": "SANDBOX_STANDARD_3",
        "class_name": "ExecutionSandboxStandard3",
      },
      {
        "name": "WORKSPACE_SANDBOX_STANDARD_1",
        "class_name": "WorkspaceSandboxStandard1",
      },
      {
        "name": "WORKSPACE_SANDBOX_STANDARD_2",
        "class_name": "WorkspaceSandboxStandard2",
      },
      {
        "name": "WORKSPACE_SANDBOX_STANDARD_3",
        "class_name": "WorkspaceSandboxStandard3",
      },
    ],
  },
  "exports": {
    "ExecutionSandbox": { "type": "durable-object", "storage": "sqlite" },
    "WorkspaceSandbox": { "type": "durable-object", "storage": "sqlite" },
    "ExecutionSandboxStandard1": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ExecutionSandboxStandard2": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ExecutionSandboxStandard3": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "WorkspaceSandboxStandard1": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "WorkspaceSandboxStandard2": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "WorkspaceSandboxStandard3": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  // Secrets (`wrangler secret put`, or .dev.vars locally):
  // CLOUDFLARE_RUNTIME_TOKEN is one account-scoped Cloudflare API token with
  // Artifacts Read and Edit and Workers AI Read, plus AI Gateway Run for
  // Anthropic/OpenAI models. Each Project gets its own Artifacts namespace,
  // which the Workers binding (fixed to one namespace) cannot address, so
  // Terminus uses the REST API. The older ARTIFACTS_API_TOKEN and
  // AI_GATEWAY_TOKEN still work when it is unset.
  // ACCESS_ALLOWED_EMAILS is a comma-separated list of the emails allowed in.
  // There is no `secrets.required`: Wrangler would demand every listed name
  // and load only listed names from .dev.vars, which rules out the older
  // names. A missing secret fails closed when it is needed instead.
  "vars": {
    "REPOSITORY_MODE": "artifacts",
    // Claude Code, Codex and Anthropic/OpenAI models, billed through AI
    // Gateway Unified Billing. See docs/harness-selection.md.
    "ALTERNATIVE_HARNESSES_ENABLED": "true",
    // Anthropic/OpenAI models under OpenCode. Off until an OpenCode run has
    // called them live; Claude Code and Codex cover those providers meanwhile.
    "OPENCODE_EXTERNAL_PROVIDERS_ENABLED": "false",
    // Enables only the Browser Run transport proof (POST /api/browser-run/proof).
    // Keep it off except while running that proof; see docs/browser-run.md.
    "BROWSER_RUN_ENABLED": "false",
    // Exact public app origin, e.g. https://terminus.YOUR_SUBDOMAIN.workers.dev.
    // An empty value permits local development only; Access protects live traffic.
    "APP_ORIGIN": "",
    // Live requests also verify the Cloudflare Access JWT and fail closed until
    // these are set. Team domain: https://YOUR_TEAM.cloudflareaccess.com. AUD:
    // the Access application's Audience tag(s), comma-separated.
    "ACCESS_REQUIRED": "true",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Local previews use *.localhost:8787. Deployment requires a separate
    // HTTPS preview domain with wildcard DNS/TLS and a route to this Worker.
    "PREVIEW_BASE_URL": "",
    // `fake` runs a role without a model. Any other value runs the model chosen
    // in Settings (General, or the network's override). The default preset,
    // Extra-light, uses @cf/zai-org/glm-5.3-flash for every text role.
    "TECHNICIAN_MODEL": "settings",
    "STATION_AGENT_MODEL": "settings",
    "CONDUCTOR_MODEL": "settings",
    "DISPATCHER_MODEL": "settings",
    // The Engineer's Clef decision model, for choices its hard rules leave open.
    "ENGINEER_MODEL": "settings",
    "STATION_MAX_RETRIES": "3",
    // The account for Artifacts and models. scripts/wrangler.mjs fills it from
    // `account_id` (or CLOUDFLARE_ACCOUNT_ID), so the ID is written once. The
    // older ARTIFACTS_ACCOUNT_ID and AI_GATEWAY_ACCOUNT_ID still work when it
    // is empty.
    "CLOUDFLARE_ACCOUNT_ID": "",
    // AI Gateway creates the `default` gateway on its first authenticated request.
    "AI_GATEWAY_ID": "default",
    // How long a fake Station Agent takes, so Trains visibly travel.
    "FAKE_INTEGRATION_CONFLICT_PATHS": "",
    "FAKE_AGENT_DELAY_MS": "4000",
    // How many times the fake Conductor returns each Station's work.
    "FAKE_CONDUCTOR_RETURNS": "1",
  },
  "env": {
    "fake": {
      // Don't inherit the preview route: `wrangler dev` would present every
      // request as that zone's hostname instead of localhost, losing the local
      // APP_ORIGIN exemption and *.localhost preview hostnames.
      "routes": [],
      "secrets": { "required": [] },
      "containers": [],
      "durable_objects": {
        "bindings": [
          { "name": "SANDBOX", "class_name": "ExecutionSandbox" },
          { "name": "WORKSPACE_SANDBOX", "class_name": "WorkspaceSandbox" },
          {
            "name": "SANDBOX_STANDARD_1",
            "class_name": "ExecutionSandboxStandard1",
          },
          {
            "name": "SANDBOX_STANDARD_2",
            "class_name": "ExecutionSandboxStandard2",
          },
          {
            "name": "SANDBOX_STANDARD_3",
            "class_name": "ExecutionSandboxStandard3",
          },
          {
            "name": "WORKSPACE_SANDBOX_STANDARD_1",
            "class_name": "WorkspaceSandboxStandard1",
          },
          {
            "name": "WORKSPACE_SANDBOX_STANDARD_2",
            "class_name": "WorkspaceSandboxStandard2",
          },
          {
            "name": "WORKSPACE_SANDBOX_STANDARD_3",
            "class_name": "WorkspaceSandboxStandard3",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "terminus",
          "migrations_dir": "migrations",
          // Local state apart from dev:worker's, which is keyed by its
          // database_id or, without one, the binding name.
          "preview_database_id": "terminus-fake",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DEPENDENCY_CACHE",
          "bucket_name": "terminus-dependency-cache",
        },
      ],
      "workflows": [
        {
          "name": "terminus-junction-fake",
          "binding": "JUNCTION_WORKFLOW",
          "class_name": "JunctionWorkflow",
        },
        {
          "name": "terminus-technician-fake",
          "binding": "TECHNICIAN_WORKFLOW",
          "class_name": "TechnicianWorkflow",
        },
        {
          "name": "terminus-dispatch-fake",
          "binding": "DISPATCH_WORKFLOW",
          "class_name": "DispatchWorkflow",
        },
        {
          "name": "terminus-dispatcher-turn-fake",
          "binding": "DISPATCHER_TURN_WORKFLOW",
          "class_name": "DispatcherTurnWorkflow",
        },
        {
          "name": "terminus-train-fake",
          "binding": "TRAIN_WORKFLOW",
          "class_name": "TrainWorkflow",
        },
        {
          "name": "terminus-station-fake",
          "binding": "STATION_WORKFLOW",
          "class_name": "StationWorkflow",
        },
        {
          "name": "terminus-integration-fake",
          "binding": "INTEGRATION_WORKFLOW",
          "class_name": "IntegrationWorkflow",
        },
        {
          "name": "terminus-conflict-watch-fake",
          "binding": "CONFLICT_WATCH_WORKFLOW",
          "class_name": "ConflictWatchWorkflow",
        },
      ],
      "vars": {
        "REPOSITORY_MODE": "fake",
        "ALTERNATIVE_HARNESSES_ENABLED": "false",
        "OPENCODE_EXTERNAL_PROVIDERS_ENABLED": "false",
        // The fake environment has no Browser binding.
        "BROWSER_RUN_ENABLED": "false",
        "APP_ORIGIN": "",
        // The fake environment is local-only and calls no models.
        "ACCESS_REQUIRED": "false",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "PREVIEW_BASE_URL": "",
        "TECHNICIAN_MODEL": "fake",
        "STATION_AGENT_MODEL": "fake",
        "CONDUCTOR_MODEL": "fake",
        "DISPATCHER_MODEL": "fake",
        "ENGINEER_MODEL": "fake",
        "STATION_MAX_RETRIES": "3",
        "FAKE_INTEGRATION_CONFLICT_PATHS": "",
        "FAKE_AGENT_DELAY_MS": "4000",
        "FAKE_CONDUCTOR_RETURNS": "1",
        "CLOUDFLARE_ACCOUNT_ID": "",
        "AI_GATEWAY_ID": "default",
      },
    },
  },
}
