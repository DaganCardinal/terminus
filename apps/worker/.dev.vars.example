# Local secrets for `npm run dev:worker` (real Artifacts and Sandboxes).
# Copy to `.dev.vars` (ignored) and fill in. `npm run dev:fake` needs none of
# these. See docs/live-setup.md for token permissions. The account ID is
# `account_id` in wrangler.local.jsonc (or add CLOUDFLARE_ACCOUNT_ID here).

# One account-scoped Cloudflare API token with Artifacts > Read, Artifacts >
# Edit and Workers AI > Read, plus AI Gateway > Run for Anthropic/OpenAI
# models. The older ARTIFACTS_API_TOKEN and AI_GATEWAY_TOKEN still work.
CLOUDFLARE_RUNTIME_TOKEN=YOUR_ACCOUNT_SCOPED_CLOUDFLARE_TOKEN

# Only checked by a deployed Worker behind Cloudflare Access; localhost
# requests skip Access.
ACCESS_ALLOWED_EMAILS=you@example.com
