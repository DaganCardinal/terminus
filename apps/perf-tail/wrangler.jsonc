// TEMPORARY benchmark instrumentation: remove this app, `tail_consumers` and
// the PERF_LOGS binding in apps/worker/wrangler.jsonc, and
// packages/protocol/src/perf-log.ts once the speed analysis is done.
//
// The `terminus` Worker's Tail Worker. It copies every `[perf]` line to R2,
// because Workers Logs loses whole invocations. Deploy it before `terminus`,
// which names it in `tail_consumers`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "terminus-perf-tail",
  "account_id": "1c4341e1232d9a44116c124bc518a0f6",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // Reached only as a tail consumer, never over HTTP.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  // Shared with `terminus`, which serves the lines at GET /api/perf-logs.
  "r2_buckets": [
    {
      "binding": "PERF_LOGS",
      "bucket_name": "terminus-perf-logs",
    },
  ],
}
