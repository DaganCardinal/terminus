{
  "$schema": "../../apps/worker/node_modules/wrangler/config-schema.json",
  "name": "terminus-browser-transport-proof",
  "main": "worker.mjs",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "browser": { "binding": "BROWSER", "remote": true },
  "containers": [
    {
      "class_name": "ExecutionSandbox",
      "image": "./Dockerfile",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "ExecutionSandbox" }],
  },
  "exports": {
    "ExecutionSandbox": { "type": "durable-object", "storage": "sqlite" },
    "ProbeOutbound": { "type": "worker" },
    "CandidateOutbound": { "type": "worker" },
  },
}
