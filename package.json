{
  "name": "terminus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @terminus/web",
    "dev:worker": "npm run dev --workspace @terminus/worker",
    "dev:fake": "npm run dev:fake --workspace @terminus/worker",
    "deploy": "npm run deploy --workspace @terminus/worker --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stress:ten": "node apps/stress-test/src/main.ts",
    "stress:offline": "npm run build --workspace @terminus/web && npm exec --workspace @terminus/worker -- vitest run src/api/stress-test.test.ts && npm exec --workspace @terminus/artifacts -- vitest run src/stress-git.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "undici": "~7.29.1",
    "sharp": "^0.35.5"
  }
}
